# Day 2 自建镜像：frontend 多阶段构建
# 说明：官方 golang:1.15-alpine 基础镜像在本机镜像源下载过慢（约 15KB/s），
# 改用 Alpine 官方仓库安装 Go 工具链，构建结果一致，且能利用已有 alpine 缓存。
FROM alpine:latest AS builder

RUN apk add --no-cache go git build-base ca-certificates

ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
ENV GO111MODULE=on

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# 构建上下文由 prepare-context.sh 生成：其中 handlers.go 已打补丁，
# 本地 Kind 下跳过 metadata.google.internal 的慢速 DNS 探测。
ARG SKAFFOLD_GO_GCFLAGS
RUN go build -gcflags="${SKAFFOLD_GO_GCFLAGS}" -o /go/bin/frontend .

FROM alpine AS release

# 精简运行时：只保留 CA 证书，去掉调试工具（net-tools/bind-tools/busybox-extras）
RUN apk add --no-cache ca-certificates

WORKDIR /src
COPY --from=builder /go/bin/frontend /src/server
COPY ./templates ./templates
COPY ./static ./static

ENV GOTRACEBACK=single
EXPOSE 8080
ENTRYPOINT ["/src/server"]
