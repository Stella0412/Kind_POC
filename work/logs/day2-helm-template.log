# Source: online-boutique/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis-cart
  labels:
    app.kubernetes.io/name: online-boutique
    app.kubernetes.io/instance: online-boutique
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: online-boutique-0.1.0
    app: redis-cart
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redis-cart
  template:
    metadata:
      labels:
        app: redis-cart
        app.kubernetes.io/name: online-boutique
        app.kubernetes.io/instance: online-boutique
        app.kubernetes.io/managed-by: Helm
        helm.sh/chart: online-boutique-0.1.0
    spec:
      serviceAccountName: default
      terminationGracePeriodSeconds: 5
      nodeSelector:
        kubernetes.io/hostname: qa-cluster-worker
      containers:
        - name: redis
          image: "redis:7.4-alpine"
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 6379
          resources:
            limits:
              cpu: 125m
              memory: 256Mi
            requests:
              cpu: 70m
              memory: 200Mi
          readinessProbe:
            periodSeconds: 5
            tcpSocket:
              port: 6379
          livenessProbe:
            periodSeconds: 5
            tcpSocket:
              port: 6379
          volumeMounts:
            - mountPath: /data
              name: redis-data
      volumes:
        - name: redis-data
          emptyDir: {}

